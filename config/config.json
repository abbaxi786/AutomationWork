{
  "settings": {
    "log_file": "logs/app.log"
  },

  "tasks": [
    {
      "task_name": "create_report_file",
      "task_type": "createFile",
      "schedule": {
        "type": "interval",
        "seconds": 20
      },
      "file": {
        "path": "output/report.txt",
        "content": "This is an auto-generated report file."
      }
    },

    {
      "task_name": "run_system_command",
      "task_type": "shell",
      "schedule": {
        "type": "interval",
        "seconds": 15
      },
      "command": "echo Task Running && dir"
    },

    {
      "task_name": "send_welcome_email",
      "task_type": "email",
      "schedule": {
        "type": "interval",
        "seconds": 30
      },
      "email": {
        "to": "admin@example.com",
        "subject": "Automation System Update",
        "body": "Your scheduled task has been executed successfully."
      }
    },

    {
      "task_name": "system_logger",
      "task_type": "log",
      "schedule": {
        "type": "interval",
        "seconds": 5
      },
      "log": {
        "messages": {
          "start": "Task started",
          "success": "Task completed successfully",
          "error": "Error occurred during execution",
          "stop": "Task stopped"
        }
      }
    }
  ]
}