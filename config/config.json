{
  "settings": {
    "log_file": "logs/test_app.log"
  },

  "tasks": [
    {
      "task_name": "test_create_file",
      "task_type": "createFile",
      "schedule": {
        "type": "interval",
        "seconds": 3
      },
      "file": {
        "path": "output/test_report.txt",
        "content": "This is a TEST file created by automation system."
      }
    },

    {
      "task_name": "test_shell_command",
      "task_type": "shell",
      "schedule": {
        "type": "interval",
        "seconds": 4
      },
      "command": "echo Hello Automation Test"
    },

    {
      "task_name": "test_logger",
      "task_type": "log",
      "schedule": {
        "type": "interval",
        "seconds": 2
      },
      "log": {
        "messages": {
          "start": "TEST: task started",
          "success": "TEST: task completed",
          "error": "TEST: error occurred",
          "stop": "TEST: task stopped"
        }
      }
    },

    {
      "task_name": "test_email",
      "task_type": "email",
      "schedule": {
        "type": "timeout",
        "seconds": 10
      },
      "email": {
        "to": "nabeelahmad@kotenterprises.com",
        "subject": "TEST EMAIL - Automation System",
        "body": "This is a test email from your Python automation project."
      }
    }
  ]
}
